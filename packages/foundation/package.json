{
  "name": "@nexfluid/foundation",
  "version": "0.5.0",
  "description": "NexFoundation: NexFluid Native tokens (themes, directions, shapes, materials, type, motion) plus an optional Nextudio compatibility sheet",
  "license": "MIT",
  "author": "gibran564",
  "homepage": "https://gibran564.github.io/nexfluid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibran564/nexfluid.git",
    "directory": "packages/foundation"
  },
  "bugs": {
    "url": "https://github.com/gibran564/nexfluid/issues"
  },
  "keywords": [
    "nexfluid",
    "design-system",
    "react",
    "motion",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "nexfluid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "nexfluid-source": "./src/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./compat/nextudio.css": {
      "nexfluid-source": "./src/compat/nextudio.css",
      "default": "./dist/compat/nextudio.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "tokens": "node gen-tokens.ts"
  }
}
