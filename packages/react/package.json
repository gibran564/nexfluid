{
  "name": "@nexfluid/react",
  "version": "0.5.0",
  "description": "NexBridge for React 19: typed NexComponents and NexWidgets over @nexfluid/components, optional NexFluid motion",
  "license": "MIT",
  "author": "gibran564",
  "homepage": "https://gibran564.github.io/nexfluid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibran564/nexfluid.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/gibran564/nexfluid/issues"
  },
  "keywords": [
    "nexfluid",
    "design-system",
    "react",
    "motion",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "nexfluid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "nexfluid-source": "./src/markdown/index.ts",
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./widgets": {
      "nexfluid-source": "./src/widgets/index.ts",
      "types": "./dist/widgets/index.d.ts",
      "default": "./dist/widgets/index.js"
    },
    "./motion": {
      "nexfluid-source": "./src/motion/index.ts",
      "types": "./dist/motion/index.d.ts",
      "default": "./dist/motion/index.js"
    },
    "./sheets": {
      "nexfluid-source": "./src/sheets/index.ts",
      "types": "./dist/sheets/index.d.ts",
      "default": "./dist/sheets/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@nexfluid/components": "0.5.0",
    "@nexfluid/core": "0.5.0",
    "@nexfluid/foundation": "0.5.0",
    "@nexfluid/sheets": "0.5.0",
    "katex": "0.16.47",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
