{
  "name": "@nexfluid/components",
  "version": "0.5.0",
  "description": "NexComponents: framework-free component contract (CSS classes nx-*) and pure behaviour helpers",
  "license": "MIT",
  "author": "gibran564",
  "homepage": "https://gibran564.github.io/nexfluid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibran564/nexfluid.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/gibran564/nexfluid/issues"
  },
  "keywords": [
    "nexfluid",
    "design-system",
    "react",
    "motion",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "nexfluid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "nexfluid-source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nexfluid/foundation": "0.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
